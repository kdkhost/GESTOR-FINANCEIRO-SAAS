APP_NAME="FinanceiroSaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="America/Sao_Paulo"
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# ========================================
# BANCO DE DADOS (Padrão MySQL/MariaDB)
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=financeiro_saas
DB_USERNAME=root
DB_PASSWORD=

# ========================================
# CACHE E SESSÃO
# ========================================
BROADCAST_CONNECTION=log
CACHE_STORE=file
CACHE_PREFIX=
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ========================================
# SEGURANÇA E AUDITORIA
# ========================================
MAX_TENTATIVAS_LOGIN=5
MINUTOS_BLOQUEIO_LOGIN=15
AUDIT_ENABLED=true

# ========================================
# E-MAIL (PHPMailer nativo do sistema)
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# PWA (App instalável)
# ========================================
PWA_ENABLED=true
PWA_NAME="${APP_NAME}"
PWA_SHORT_NAME="Financeiro"
PWA_THEME_COLOR="#3b82f6"
PWA_BACKGROUND_COLOR="#ffffff"

# ========================================
# UPLOADS E LOGS
# ========================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
FILESYSTEM_DISK=local
